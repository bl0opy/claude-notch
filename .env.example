# Copy to .env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
# STT model: flux-general-en (Flux) or nova-3 (fallback)
DEEPGRAM_MODEL=flux-general-en
# TTS voice: any Deepgram Aura-2 voice
DEEPGRAM_VOICE=aura-2-thalia-en
WS_HOST=127.0.0.1
WS_PORT=8765
# Working directory Claude Code operates in
CLAUDE_CWD=.
